# Project Annapurna Environment Variables
# Safe template - do not add secrets or real environment values to this file.
# Scope legend:
#   [Public]  Browser-visible via NEXT_PUBLIC_ prefix. Safe for client bundles.
#   [Server]  Server-only runtime secret. Never expose to client bundles or browser responses.
#   [Scope]   Required in both Preview and Production unless noted otherwise.

# --- Supabase Configuration ---
# [Public] [Preview, Production]
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# [Public] [Preview, Production]
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key
# [Server] [Preview, Production] Privileged operations (internal contact submission, admin bootstrap)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Application Base URL ---
# [Public] [Preview: https://<branch-or-deployment>.vercel.app, Production: https://annapurna.org]
NEXT_PUBLIC_APP_URL=https://your-preview-or-production-domain.vercel.app

# --- Administrative Access ---
# [Server] [Preview, Production] Minimum 16 characters required for bootstrap
ADMIN_BOOTSTRAP_SECRET=your-min-16-char-bootstrap-secret

# --- Routing & Geocoding Services ---
# [Server] [Preview, Production] OpenRouteService / Geoapify routing backend
GEOAPIFY_API_KEY=your-routing-api-key
# [Public] [Preview, Production] Optional map tile styling key (defaults to standard OSM tiles if unset)
NEXT_PUBLIC_GEOAPIFY_MAP_KEY=your-browser-tile-key

# --- Optional Integrations ---
# [Server] [Optional] Google Sheets operational sync webhook
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/your-script-id/exec
